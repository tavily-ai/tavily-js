{
  "name": "@tavily/core",
  "version": "0.7.14",
  "description": "Official JavaScript library for Tavily.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./parameters": {
      "import": {
        "types": "./dist/parameters.d.mts",
        "default": "./dist/parameters.mjs"
      },
      "require": {
        "types": "./dist/parameters.d.ts",
        "default": "./dist/parameters.js"
      }
    },
    "./agent-schemas": {
      "import": {
        "types": "./dist/agent-schemas.d.mts",
        "default": "./dist/agent-schemas.mjs"
      },
      "require": {
        "types": "./dist/agent-schemas.d.ts",
        "default": "./dist/agent-schemas.js"
      }
    }
  },
  "homepage": "https://tavily.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tavily-ai/tavily-js.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test tests/search.test.mjs",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "search",
    "crawl",
    "extract",
    "agent",
    "ai",
    "tavily"
  ],
  "author": "Tavily",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.6",
    "typescript": "^5.6.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "https-proxy-agent": "^7.0.6",
    "js-tiktoken": "^1.0.14"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
